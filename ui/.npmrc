# Tauri runs `pnpm dev` / `pnpm build` as beforeDevCommand/beforeBuildCommand,
# which gives pnpm no TTY. Without this, any node_modules written by a
# different pnpm major makes pnpm stop and ask before purging the directory,
# failing with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
confirm-modules-purge=false
